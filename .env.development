# Local development only.
#
# Vite loads `.env` in every mode, then lets `.env.[mode]` override it, so this
# file wins for `vite dev` while a production build (`vite build` -> mode
# `production`) still uses the deployed API from `.env`. That keeps local
# development from calling production (which answers localhost with a CORS
# error, because the production API only allows its own frontend origin).
VITE_API_URL=http://localhost:3000
